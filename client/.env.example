# India AI Ad Creator — environment variables
#
# This file lives at client/.env.example. To start dev:
#   cp client/.env.example client/.env.local
#   # then fill in values. .env.local is gitignored.
#
# Next.js auto-loads .env.local from the directory containing package.json
# (client/, NOT the repo root).
# In Vercel, set each var for Production / Preview / Development as appropriate.
# See TODO §20 for the full reference.

# ─── Required to boot ────────────────────────────────────────────────────────
# Supabase project (Settings → API). Leave empty for a no-creds dev boot —
# the dashboard layout falls back to "you@brand.in (dev mode)" until set.
# Once you have a real Supabase project: paste the URL + anon key here, then
# the auth flow + RLS protection activate automatically (see TODO §6).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── Public (browser-safe) — optional until that integration ships ───────────
# Empty values are coerced to undefined by lib/env.ts — fine to leave blank.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# ─── Server-only (NEVER prefix with NEXT_PUBLIC_) ────────────────────────────
# Supabase service role — bypasses RLS. Treat like a god-key.
SUPABASE_SERVICE_ROLE_KEY=""

# AI providers
GROQ_API_KEY=""
HUGGINGFACE_TOKEN=""

# Cloudflare R2
CLOUDFLARE_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_PUBLIC_BASE="https://assets.adcreator.in"
R2_BUCKET_UPLOADS="adcreator-uploads"
R2_BUCKET_PROCESSED="adcreator-processed"
R2_BUCKET_PUBLIC="adcreator-public"

# Razorpay
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
RAZORPAY_PLAN_STARTER=""
RAZORPAY_PLAN_PRO=""
RAZORPAY_PLAN_AGENCY=""
RAZORPAY_PLAN_STARTER_ANNUAL=""
RAZORPAY_PLAN_PRO_ANNUAL=""
RAZORPAY_PLAN_AGENCY_ANNUAL=""

# Cloudflare Turnstile
TURNSTILE_SECRET_KEY=""

# Email
RESEND_API_KEY=""

# Errors
SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""

# ─── MCP / Agent tooling (developer machines only — see AGENTS.md) ───────────
# Set these in your shell or ~/.config/claude/.env, NOT here.
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_PROJECT_REF_LOCAL=
# SUPABASE_PROJECT_REF_PROD=
# POSTHOG_AUTH_HEADER=
